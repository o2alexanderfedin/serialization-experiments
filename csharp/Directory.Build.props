<Project>

  <!-- Shared settings for every project in the C# serialization experiments solution.
       Kept here rather than duplicated per-csproj so experiments stay consistent. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Warnings are defects. A serialization experiment that builds dirty produces
         numbers nobody should trust. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
