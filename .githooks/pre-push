#!/usr/bin/env bash
# git-flow guard: reject pushing branches whose names violate git-flow conventions.
#
# Solo workflow: `git flow feature finish` merges into develop locally and develop/main
# are pushed directly, so pushes to those branches are expected and allowed. The commit
# discipline is enforced by the pre-commit hook, which keeps work on feature branches.
#
# stdin format (per git docs): <local ref> <local sha> <remote ref> <remote sha>
set -uo pipefail

VALID='^(main|develop)$|^(feature|release|hotfix|bugfix|support)/.+'
ZERO='0000000000000000000000000000000000000000'

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deletions are fine; nothing to validate.
  [[ "$local_sha" == "$ZERO" ]] && continue

  remote_branch="${remote_ref#refs/heads/}"

  # Tags and other non-branch refs are not our business.
  [[ "$remote_ref" == refs/heads/* ]] || continue

  if [[ ! $remote_branch =~ $VALID ]]; then
    cat >&2 <<EOF

❌ Branch '$remote_branch' does not follow git-flow naming conventions.

Expected one of:
  main               develop
  feature/<name>     bugfix/<name>     release/<version>
  hotfix/<version>   support/<name>

Rename before pushing:
    git branch -m feature/<name>

(Emergency escape hatch: git push --no-verify)

EOF
    status=1
  fi
done

exit $status
