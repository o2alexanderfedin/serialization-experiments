#!/usr/bin/env bash
# git-flow guard: keep work on branches, off main/develop.
#
# Merge commits produced by `git flow feature|release|hotfix finish` do not run this hook
# (git uses pre-merge-commit for those), so the normal git-flow workflow is unaffected.
set -uo pipefail

BRANCH="$(git rev-parse --abbrev-ref HEAD)"

PROTECTED_BRANCHES='^(main|develop)$'
VALID_BRANCH_PATTERN='^(feature|release|hotfix|bugfix|support)/.+'

if [[ $BRANCH =~ $PROTECTED_BRANCHES ]]; then
  cat >&2 <<EOF

❌ Direct commits to '$BRANCH' are not allowed.

Work happens on branches; '$BRANCH' only receives merges from git-flow.

  New feature / experiment:
    git flow feature start <name>
    # ...work...
    git flow feature finish <name>    # merges into develop

  Bugfix on develop:
    git flow bugfix start <name>

  Release:
    git flow release start <version>  # finish merges into main + develop, tags it

  Hotfix:
    git flow hotfix start <version>

(Emergency escape hatch: git commit --no-verify)

EOF
  exit 1
fi

if [[ ! $BRANCH =~ $VALID_BRANCH_PATTERN ]]; then
  cat >&2 <<EOF

⚠️  Branch '$BRANCH' does not follow git-flow naming conventions.

Expected one of:
  feature/<name>     New features and experiments
  bugfix/<name>      Fixes targeting develop
  release/<version>  Release preparation
  hotfix/<version>   Urgent production fixes
  support/<name>     Long-lived support branches

Commit allowed, but rename before pushing.

EOF
fi

exit 0
